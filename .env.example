# ── Seguridad del webhook (OBLIGATORIO). Genera uno largo: python -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=cambia-esto

# ── Modo: signals = solo Telegram (por defecto) | demo = BingX VST (saldo virtual) | live = DINERO REAL
TRADING_MODE=signals

# ── BingX (solo para demo/live). Permisos: Lectura + Trading de futuros. SIN retiros.
BINGX_API_KEY=
BINGX_API_SECRET=
# BINGX_BASE_URL=            # opcional; por defecto demo -> https://open-api-vst.bingx.com | live -> https://open-api.bingx.com
POSITION_MODE=hedge          # hedge (por defecto en BingX) | oneway
MARGIN_TYPE=ISOLATED
LEVERAGE=3                   # apalancamiento configurado en el exchange
MAX_LEVERAGE=3               # tope de nocional / equity al calcular el tamaño

# ── Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Riesgo (replica las reglas del indicador; el bot las vuelve a comprobar)
ACCOUNT_SIZE=10000           # solo en modo signals; en demo/live se lee el equity de BingX
RISK_PCT=0.5
MAX_TRADES_PER_DAY=2
MAX_LOSS_STREAK=2
MIN_RR=1.5
MAX_SLIPPAGE_PCT=0.15        # descarta la entrada si el precio se alejó más de este % del precio de la señal
ALLOWED_SYMBOLS=BTC-USDT     # separados por coma, formato BingX

# ── Avisos
NOTIFY_ABSORPTION=true
NOTIFY_SKIPS=true
DAILY_RESET_TZ=UTC
DATA_DIR=.                   # en Railway: monta un Volume en /data y pon DATA_DIR=/data

# ── Escáner de todas las monedas de BingX (datos públicos, no necesita API key)
SCAN_ENABLED=true
SCAN_INTERVAL_MIN=5          # se ejecuta al cierre de cada vela de 5m (+15 s)
SCAN_TOP=40                  # nº de perpetuos USDT con más volumen 24h
SCAN_MIN_VOLUME=5000000      # volumen 24h mínimo en USDT
SCAN_ALERT_STAGE=4           # 4 = aviso inmediato cuando hay absorción en zona; 5 = solo con primer cambio
SCAN_SUMMARY_MIN=60          # resumen general cada X minutos (0 = desactivado)
